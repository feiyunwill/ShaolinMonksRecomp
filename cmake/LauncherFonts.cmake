# Embeds the launcher typeface so the window looks the same on every system.
set(OPENSHAO_LAUNCHER_FONTS "${GEN}/launcher_fonts.cpp")
set(OPENSHAO_FONT_CONTENT "// Generated from resources/fonts by cmake/LauncherFonts.cmake.\n#include <cstddef>\nnamespace openshao::launcher::fonts {\n")
foreach(weight Regular Medium SemiBold)
    set(font "${CMAKE_CURRENT_SOURCE_DIR}/resources/fonts/HankenGrotesk-${weight}.ttf")
    file(READ "${font}" bytes HEX)
    string(LENGTH "${bytes}" length)
    math(EXPR length "${length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
    string(APPEND OPENSHAO_FONT_CONTENT "extern const unsigned char k${weight}[] = {${bytes}};\nextern const size_t k${weight}Size = ${length};\n")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${font}")
endforeach()
string(APPEND OPENSHAO_FONT_CONTENT "}\n")
file(WRITE "${OPENSHAO_LAUNCHER_FONTS}.tmp" "${OPENSHAO_FONT_CONTENT}")
configure_file("${OPENSHAO_LAUNCHER_FONTS}.tmp" "${OPENSHAO_LAUNCHER_FONTS}" COPYONLY)
